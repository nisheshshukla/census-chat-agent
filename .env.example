# Copy to .env and fill in the three values marked <...>. Never commit .env.

ANTHROPIC_API_KEY=<your Anthropic API key>
AGENT_MODEL=claude-opus-5
CLASSIFIER_MODEL=claude-haiku-4-5
AGENT_EFFORT=low

SNOWFLAKE_ACCOUNT=<ORGNAME-ACCOUNTNAME from Snowsight: Admin > Accounts>
SNOWFLAKE_USER=CENSUS_APP
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8
SNOWFLAKE_ROLE=CENSUS_READER
SNOWFLAKE_WAREHOUSE=CENSUS_WH
SNOWFLAKE_APP_DATABASE=CENSUS_APP_DB
SNOWFLAKE_APP_SCHEMA=SEMANTIC

FIELD_SEARCH_BACKEND=local
CLASSIFIER_ENABLED=true
GROUNDING_ENABLED=true
SPECULATIVE_EXECUTION=true
SIMULATE_FAILURES_ENABLED=true

DEMO_USER=reviewer
DEMO_PASSWORD=<password for the sign-in screen; empty disables auth locally>

LOG_LEVEL=INFO
